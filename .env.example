# Copy to .env and fill in your own values. Never commit .env.

# Gemini (free key from Google AI Studio)
GEMINI_API_KEY=

# Model IDs, format gemini/<model-id>. Run `uv run mia models` to list what your key can use.
# Bulk = cheapest model with the largest free daily quota (a Flash-Lite model).
# Smart = planner and final synthesis (a Flash model, or Flash-Lite if your Flash quota is tiny).
MIA_MODEL_BULK=
MIA_MODEL_SMART=

# Free-tier limits: check aistudio.google.com/rate-limit and set these to stay under them.
MIA_LLM_RPM=10
MIA_MAX_LLM_CALLS_PER_RUN=200

# Web search (optional on Day 1: the ddgs fallback needs no key)
TAVILY_API_KEY=

# Reddit API (optional; see docs/data_sources.md for the fallback)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Where cache, snapshots, indexes and runs live (default: ./data)
# MIA_DATA_DIR=
