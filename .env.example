# Copy to .env and fill in your own values. Never commit .env.

# Gemini (free key from Google AI Studio)
GEMINI_API_KEY=

# Model IDs, format gemini/<model-id>. Run `uv run mia models` to list what your key can use.
# These are the tested settings, and the shared snapshot's answers were made with them: change
# them and offline runs from the snapshot can no longer reuse its answers.
# Bulk = almost every call: extraction, judging, the scouts' choices (Flash-Lite: biggest quota).
# Smart = the few calls that shape a report, such as the feature list (Flash: ~20 a day free).
# Backup = answers when the bulk model stays overloaded (another Flash-Lite). Empty for none.
MIA_MODEL_BULK=gemini/gemini-3.5-flash-lite
MIA_MODEL_SMART=gemini/gemini-3.6-flash
MIA_MODEL_BULK_FALLBACK=gemini/gemini-3.1-flash-lite

# How much the models think before answering: minimal | low | medium | high.
# Lower is faster; the defaults are low for bulk work and medium for smart work.
MIA_THINKING_BULK=low
MIA_THINKING_SMART=medium

# Free-tier limits: check aistudio.google.com/rate-limit and set these to stay under them.
MIA_LLM_RPM=10
MIA_MAX_LLM_CALLS_PER_RUN=200

# Web search (optional on Day 1: the ddgs fallback needs no key)
TAVILY_API_KEY=

# Reddit API: leave empty. Reddit is left out unless Reddit approves API access
# (docs/data_sources.md).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Where cache, snapshots, indexes and runs live (default: ./data)
# MIA_DATA_DIR=

# Local retrieval models (fastembed, CPU). Downloaded to <data>/models on first use, about 220 MB.
# MIA_EMBED_MODEL=BAAI/bge-small-en-v1.5
# MIA_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
